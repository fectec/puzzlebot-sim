<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <gazebo reference="wheel_left_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
    </gazebo>

    <gazebo reference="wheel_right_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
    </gazebo>
    
    <gazebo reference="caster_link">
        <mu1>0.1</mu1>
        <mu2>0.1</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel>
    </gazebo>

    <gazebo reference="forks_link">
        <mu1>100.0</mu1>
        <mu2>100.0</mu2>
    </gazebo>
    
    <gazebo>
        <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

    <gazebo reference="laser">
        <sensor name="lidar" type="gpu_lidar">
            <always_on>true</always_on>
            <visualize>false</visualize>
            <update_rate>5.5</update_rate> 
            <topic>scan</topic>
            <gz_frame_id>laser</gz_frame_id> 
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1.0</resolution>
                        <min_angle>0.0</min_angle>
                        <max_angle>6.283185</max_angle> 
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min> 
                    <max>12.0</max> 
                    <resolution>0.001</resolution> 
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev> 
                </noise>
            </lidar>
        </sensor>
    </gazebo>
    
    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <always_on>true</always_on>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <camera>
                <camera_info_topic>camera_info</camera_info_topic>
                <horizontal_fov>1.36</horizontal_fov> 
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>360</height>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>8.0</far>
                </clip>
                <lens>
                    <intrinsics>
                        <fx>395.643134</fx>
                        <fy>395.381934</fy>
                        <cx>313.734992</cx>
                        <cy>188.265070</cy>
                        <s>0</s>
                    </intrinsics>
                </lens>
                <distortion>
                    <k1>-0.348434917</k1>
                    <k2>0.153734767</k2>
                    <p1>-0.000136492904</p1>
                    <p2>-0.000164288390</p2>
                    <k3>-0.0365786767</k3>
                    <center>0.5 0.5</center>
                </distortion>
            </camera>
            <topic>image_raw</topic>
            <gz_frame_id>camera_optical_link</gz_frame_id> 
        </sensor>
    </gazebo>

    <gazebo reference="debug_camera_link">
        <sensor name="debug_camera" type="camera">
            <always_on>true</always_on>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <camera>
                <camera_info_topic>debug/camera_info</camera_info_topic>
                <horizontal_fov>1.36</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>360</height>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>8.0</far>
                </clip>
                <lens>
                    <intrinsics>
                        <fx>395.643134</fx>
                        <fy>395.381934</fy>
                        <cx>313.734992</cx>
                        <cy>188.265070</cy>
                        <s>0</s>
                    </intrinsics>
                </lens>
                <distortion>
                    <k1>-0.348434917</k1>
                    <k2>0.153734767</k2>
                    <p1>-0.000136492904</p1>
                    <p2>-0.000164288390</p2>
                    <k3>-0.0365786767</k3>
                    <center>0.5 0.5</center>
                </distortion>
            </camera>
            <topic>debug/image_raw</topic>
            <gz_frame_id>debug_camera_optical_link</gz_frame_id> 
        </sensor>
    </gazebo>

</robot>